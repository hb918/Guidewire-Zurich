{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": false,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "pages/**/*.ts",
    "step-definitions/**/*.ts",
    "helper/**/*.ts"
  ],
  "exclude": ["node_modules", "reports"]
}
